# mock = built-in simulated lab (no back end needed). live = real back end per contracts/.
NEXT_PUBLIC_API_MODE=mock
# Live mode only
AEGIS_API_ORIGIN=http://10.10.10.30:8000
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_OIDC_AUTHORITY=https://keycloak.mgmt.salonemutual.lab/realms/aegis
NEXT_PUBLIC_OIDC_CLIENT_ID=aegis-cockpit

# ---- Live AI study tutor (server only: never prefix these with NEXT_PUBLIC_) ----
# Easiest: paste ONE key here. The provider is detected from the key's format
# (sk-ant- Claude, sk-proj-/sk- OpenAI, AIza Gemini, gsk_ Groq, sk-or- OpenRouter, xai- Grok, pplx- Perplexity).
AI_API_KEY=
# Optional: force a provider or a model (model names change over time).
# AI_PROVIDER=anthropic   # anthropic|openai|gemini|groq|mistral|deepseek|xai|openrouter|together|fireworks|perplexity|cerebras|ollama|lmstudio|custom
# AI_MODEL=
# Or set several provider keys: they are tried in order, so the next one answers if one fails.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# PERPLEXITY_API_KEY=
# CEREBRAS_API_KEY=
# Azure OpenAI needs all three:
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
# Free local models (no key): Ollama or LM Studio
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Any other OpenAI-compatible server:
# AI_BASE_URL=
# Requests per minute per address (default 20). Set AI_TUTOR_DISABLED=1 to switch the live tutor off.
# AI_TUTOR_PER_MINUTE=20
