{
  "name": "@aegis/web",
  "version": "0.1.0",
  "private": true,
  "description": "AEGIS Operator Platform cockpit (front end)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../../contracts/openapi.yaml -o src/api/schema.d.ts",
    "lint": "next lint",
    "scenarios": "node scripts/bundle-scenarios.mjs",
    "prebuild": "node scripts/bundle-scenarios.mjs",
    "contracts:examples": "EXPORT_EXAMPLES=1 vitest run tests/unit/zz-export-examples.test.ts",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dockview-react": "^8.8.0",
    "echarts": "^6.1.0",
    "guacamole-common-js": "^1.5.0",
    "lucide-react": "^1.63.0",
    "next": "^15.5.28",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
